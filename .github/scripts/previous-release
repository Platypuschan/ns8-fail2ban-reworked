#!/usr/bin/env python3

# SPDX-License-Identifier: GPL-3.0-or-later

"""Print the published release that the update test starts from.

This is the newest stable SemVer tag of IMAGE that is not newer than
CATALOG_VERSION, i.e. the version a Software Center user runs before updating
to the image under test. If CATALOG_VERSION itself is already published (a
change outside the module image keeps the version), that release is used.
"""

import argparse
import importlib.machinery
import importlib.util
import json
import sys
import urllib.parse
import urllib.request
from pathlib import Path

HERE = Path(__file__).resolve().parent
ROOT = HERE.parents[1]


def load_version_module():
    loader = importlib.machinery.SourceFileLoader(
        "check_catalog_version", str(HERE / "check-catalog-version")
    )
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


version = load_version_module()


def newest_release(tags, current):
    """Return the newest stable tag that is not newer than current, or None."""
    limit = version.parse_version(current)
    released = []
    for tag in tags:
        try:
            key = version.parse_version(tag)
        except version.VersionError:
            continue
        # Stable releases only: those are what the catalog offers by default.
        if key[3] == 1 and key <= limit:
            released.append((key, tag))
    return max(released)[1] if released else None


def registry_tags(image):
    if not image.startswith("ghcr.io/"):
        raise SystemExit(f"Expected a ghcr.io image: {image}")
    name = image.removeprefix("ghcr.io/")
    query = urllib.parse.urlencode({"scope": f"repository:{name}:pull", "service": "ghcr.io"})
    with urllib.request.urlopen(f"https://ghcr.io/token?{query}", timeout=30) as response:
        token = json.load(response)["token"]
    request = urllib.request.Request(
        f"https://ghcr.io/v2/{name}/tags/list?n=1000",
        headers={"Authorization": f"Bearer {token}"},
    )
    with urllib.request.urlopen(request, timeout=30) as response:
        return json.load(response).get("tags") or []


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("image", help="image name without tag, e.g. ghcr.io/owner/module")
    args = parser.parse_args()
    current = (ROOT / "CATALOG_VERSION").read_text(encoding="utf-8").strip()
    tag = newest_release(registry_tags(args.image), current)
    if tag is None:
        print(f"No published release of {args.image} up to {current}", file=sys.stderr)
        return 1
    print(f"{args.image}:{tag}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
