{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "whitelist",
    "revision"
  ],
  "properties": {
    "whitelist": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "string"
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    }
  }
}
